# Canonical form used by embeddings_only_fallback_intent for unmatched input.
define user out of scope
  "can you help me with something unrelated"

# ---------- Bot messages ----------
define bot provide answer
  "{{ laccd.answer }}"

define bot refuse off topic
  "I'm the {{ campus_name }} assistant, so I can only help with LACCD topics — enrollment, classes, transfer and articulation, program requirements, course planning, and campus services. I can't help with homework or general questions, but ask me anything about your college and I'll jump in."

define bot greet and offer help
  "Hi! I'm your {{ campus_name }} assistant. I can help with classes, programs, transfer, prerequisites, course planning, and campus services. What would you like to know?"

# ---------- In-scope flows: delegate to the orchestrator ----------
define flow answer program
  user ask programs
  $laccd = execute answer_laccd
  bot provide answer

define flow answer schedule
  user ask schedule
  $laccd = execute answer_laccd
  bot provide answer

define flow answer transfer
  user ask transfer
  $laccd = execute answer_laccd
  bot provide answer

define flow answer requisites
  user ask requisites
  $laccd = execute answer_laccd
  bot provide answer

define flow answer course info
  user ask course info
  $laccd = execute answer_laccd
  bot provide answer

define flow answer instructor
  user ask instructor
  $laccd = execute answer_laccd
  bot provide answer

define flow answer sequence
  user ask course sequence
  $laccd = execute answer_laccd
  bot provide answer

define flow answer ztc
  user ask ztc
  $laccd = execute answer_laccd
  bot provide answer

define flow answer services
  user ask campus services
  $laccd = execute answer_laccd
  bot provide answer

# ---------- Greeting flow (multi-turn: bot offers help, next turn is handled by its own flow) ----------
define flow greeting
  user express greeting
  bot greet and offer help

# ---------- Out-of-scope flows: refuse, never call generation ----------
define flow refuse homework
  user ask homework help
  bot refuse off topic
  stop

define flow refuse general
  user ask general knowledge
  bot refuse off topic
  stop

define flow refuse coding
  user ask coding help
  bot refuse off topic
  stop

define flow refuse creative
  user ask creative writing
  bot refuse off topic
  stop

define flow refuse unrelated
  user ask unrelated
  bot refuse off topic
  stop

define flow refuse fallback
  user out of scope
  bot refuse off topic
  stop
