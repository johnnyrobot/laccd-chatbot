# LACCD chatbot — example environment file.
#
# Copy to `.env` (and/or `.env.local`) and fill in real values. NEVER commit
# `.env` or `.env.local` — only this example is tracked. Config loads `.env`
# then `.env.local` (see backend/app/config.py).

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="LACCD Campus Chatbot"
# Set to "production" in a production deployment. When CORS_ALLOW_ORIGINS is
# unset, CORS defaults to the 9 campus domains instead of "*".
APP_ENV=development
# Comma-separated CORS allowlist. Leave UNSET in production to auto-default to
# the 9 campus domains. Set to "*" to explicitly allow any origin (dev only).
# CORS_ALLOW_ORIGINS=*

# ── Reverse-proxy / client identity (rate limiting) ──────────────────────────
# REQUIRED behind Caddy/nginx. Comma-separated IPs of the trusted reverse
# proxy/proxies that sit directly in front of this app. Only when the socket
# peer is one of these is X-Forwarded-For honored; the real client is taken as
# the RIGHTMOST XFF hop appended by the trusted proxy. If this is empty, XFF is
# ignored and every request behind the proxy collapses to a single client
# identity (per-client rate limits then apply to all users at once).
#
# Example: Caddy on the Docker `proxy` network; set this to its resolved address.
# TRUSTED_PROXY_HOSTS=proxy-address
# Optional stable HMAC secret for pseudonymous client identifiers in structured
# logs. Use a random secret of at least 32 bytes and do not commit it. When
# unset, a process-random key makes identifiers rotate on every app restart.
# CLIENT_LOG_HMAC_KEY=

# ── Global daily budget caps (Gemini spend) ──────────────────────────────────
# Env-configurable knobs; defaults mirror the constants in rate_limiter.py and
# target the tight pilot budget (~$1.85/day). Raise to scale up.
TEXT_CHAT_DAILY_LIMIT=2000
VOICE_CALL_DAILY_LIMIT=20
FALLBACK_DAILY_LIMIT=500

# ── Per-client rate limits ───────────────────────────────────────────────────
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY_PER_CLIENT=100
CHAT_MAX_BODY_BYTES=65536
CHAT_MAX_CONCURRENT_REQUESTS=8
CHAT_REQUEST_TIMEOUT_SECONDS=45
# Per-client daily cap on LiveKit voice-token mints (in addition to the global
# VOICE_CALL_DAILY_LIMIT) so one actor can't drain every campus's voice budget.
VOICE_RATE_LIMIT_PER_DAY_PER_CLIENT=5

# ── Admin / auth ─────────────────────────────────────────────────────────────
# Unlocks /api/rate-limit and /api/ingest/{bootstrap,refresh,purge-old}.
# When unset those endpoints return 503 (fail closed).
# ADMIN_API_KEY=change-me
# Comma-separated SHA-256 hashes of allowed mobile-tool bearer tokens. When
# unset, /api/tools/* return 503.
# MOBILE_TOOL_TOKEN_HASHES=
MOBILE_TOOL_RATE_PER_MINUTE=60

# ── Gemini / models ──────────────────────────────────────────────────────────
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1024
USE_GEMINI_FILE_SEARCH=true
DEFAULT_CAMPUS=LAMC

# ── OpenRouter (Tier-2 fallback) ─────────────────────────────────────────────
# OPENROUTER_API_KEY=

# ── Neo4j ────────────────────────────────────────────────────────────────────
# NEO4J_URI=bolt://127.0.0.1:7688
# NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-before-deployment

# ── Langfuse (tracing) ───────────────────────────────────────────────────────
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=

# ── Guardrails (off by default; enable only after running the pinned eval) ───
GUARDRAILS_ENABLED=false
GUARDRAILS_FAIL_OPEN=true

# ── Voice cost accounting (USD per 1M tokens) ───────────────────────────────
# The Gemini Live session runs inside the LiveKit google plugin and never
# reaches Langfuse, so voice spend is logged from LiveKit's own token counts
# instead (see voice_agent/usage.py). Defaults below are published Gemini Live
# native-audio rates; override any of them when pricing changes — a bad value
# is ignored with a warning rather than failing the call.
# VOICE_PRICE_INPUT_AUDIO_PER_MTOK=3.0
# VOICE_PRICE_INPUT_TEXT_PER_MTOK=0.5
# VOICE_PRICE_OUTPUT_AUDIO_PER_MTOK=12.0
# VOICE_PRICE_OUTPUT_TEXT_PER_MTOK=2.0
# VOICE_PRICE_CACHED_INPUT_AUDIO_PER_MTOK=0.75
# VOICE_PRICE_CACHED_INPUT_TEXT_PER_MTOK=0.125

# Voice credentials and hard session limits
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
VOICE_TOKEN_TTL_SECONDS=600
VOICE_MAX_SESSION_SECONDS=1200
